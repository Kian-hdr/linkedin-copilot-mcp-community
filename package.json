{
  "name": "linkedin-copilot-mcp-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless local LinkedIn relationship memory, evidence-backed classification and draft MCP.",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
